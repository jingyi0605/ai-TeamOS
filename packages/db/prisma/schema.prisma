// PostgreSQL owns this trigger-maintained search projection. Keeping the
// introspected shape here prevents `prisma db push` from treating the table as
// unknown on later deploys. Prisma Client does not expose the unsupported
// tsvector field; application search continues to use the existing raw SQL.
model SearchDocument {
  id String                   @id
  kind String
  sourceType String
  sourceId String                   @db.Uuid
  entityId String
  channelId String?                  @db.Uuid
  messageId String?                  @db.Uuid
  botId String?                  @db.Uuid
  title String                   @default("")
  subtitle String                   @default("")
  content String                   @default("")
  url String?
  createdAt DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt DateTime                 @default(now()) @db.Timestamptz(6)
  searchVector Unsupported("tsvector")?

  @@index([kind, updatedAt(sort: Desc)], map: "outcomego_search_document_kind_updated_at_sort_desc_idx")
  @@index([sourceType, sourceId], map: "outcomego_search_document_source_idx")
  @@ignore
  @@map("outcomego_search_document")
}

