generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ComputerStatus {
  starting
  ready
  unavailable
  degraded
  @@map("outcomego_computer_status")
}

enum BotStatus {
  provisioning
  active
  archived
  failed
  @@map("outcomego_bot_status")
}

enum OnboardingStatus {
  pending
  queued
  running
  completed
  failed
  skipped_by_user
  @@map("outcomego_onboarding_status")
}

enum ConversationContinuity {
  empty
  attached
  detached
  @@map("outcomego_conversation_continuity")
}

enum MessageRole {
  user
  assistant
  system
  @@map("outcomego_message_role")
}

enum MessageStatus {
  queued
  streaming
  completed
  failed
  @@map("outcomego_message_status")
}

enum ChannelKind {
  bot_dm
  agent_dm
  group
  @@map("outcomego_channel_kind")
}

enum ChannelMessageSender {
  user
  agent
  system
  @@map("outcomego_channel_message_sender")
}

enum ChannelRoundStatus {
  queued
  running
  completed
  failed
  @@map("outcomego_channel_round_status")
}

enum ChannelDeliveryStatus {
  pending
  queued
  processing
  completed
  failed
  skipped
  @@map("outcomego_channel_delivery_status")
}

enum RunOrigin {
  user
  agent
  group
  bootstrap
  routine
  event
  connector
  background_revival
  handoff_resume
  broadcast
  @@map("outcomego_run_origin")
}

enum RoutineScheduleKind {
  cron
  interval
  event
  @@map("outcomego_routine_schedule_kind")
}

enum RoutineExecutionKind {
  scheduled
  test
  @@map("outcomego_routine_execution_kind")
}

enum RoutineExecutionStatus {
  queued
  running

  completed
  failed
  cancelled
  skipped
  @@map("outcomego_routine_execution_status")
}

enum RunStatus {
  queued
  running

  completed
  failed
  cancelled
  interrupted
  @@map("outcomego_run_status")
}

enum InboxStatus {
  pending
  processing
  completed
  failed
  @@map("outcomego_inbox_status")
}

enum OutboxStatus {
  pending
  delivering
  delivered
  failed
  @@map("outcomego_outbox_status")
}

enum PushDevicePlatform {
  ios
  android
  @@map("outcomego_push_device_platform")
}

enum RunItemKind {
  agent_message
  reasoning
  command
  file_change
  tool
  compaction
  error
  @@map("outcomego_run_item_kind")
}

enum RunItemStatus {
  pending
  running

  completed
  failed
  cancelled
  @@map("outcomego_run_item_status")
}



enum IdempotencyStatus {
  processing
  completed
  failed
  @@map("outcomego_idempotency_status")
}

enum BitwardenReadApprovalStatus {
  pending
  approved
  denied
  expired
  @@map("outcomego_bitwarden_read_approval_status")
}

enum MemoryScope {
  agent
  user
  @@map("outcomego_memory_scope")
}

enum MemoryTier {
  profile
  log
  note
  @@map("outcomego_memory_tier")
}

enum TodoStatus {
  pending
  in_progress
  completed
  cancelled
  @@map("outcomego_todo_status")
}

enum SubagentStatus {
  provisioning
  queued
  running
  waiting
  completed
  failed
  stopped
  @@map("outcomego_subagent_status")
}

enum PluginInstallStatus {
  installed
  error
  @@map("outcomego_plugin_install_status")
}

enum PluginConnectionStatus {
  disconnected
  needs_auth
  ready
  error
  revoked
  @@map("outcomego_plugin_connection_status")
}


enum PluginInvocationStatus {
  running
  completed
  failed
  @@map("outcomego_plugin_invocation_status")
}

enum VoiceSessionStatus {
  created
  active
  closing
  ended
  failed
  @@map("outcomego_voice_session_status")
}

enum VoiceTurnStatus {
  listening
  processing
  speaking
  output_paused
  completed
  superseded
  interrupted
  cancelled
  failed
  @@map("outcomego_voice_turn_status")
}

model Computer {
  id String         @id @default(uuid()) @db.Uuid
  name String         @default("OutcomeGo computer")
  status ComputerStatus @default(starting)
  capabilities Json           @default("{}")
  lastSeenAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  @@map("outcomego_computer")
}

model Bot {
  id String       @id @default(uuid()) @db.Uuid
  name String
  title String       @default("")
  description String       @default("")
  instructions String       @default("")
  voice String       @default("")
  templateRecipe Json?
  icon String       @default("●")
  color String       @default("#4f7cff")
  namedBy String       @default("user")
  notificationsEnabled Boolean  @default(true)
  hiddenFromSidebar Boolean     @default(false)
  /// Email and Slack drafts send without a review card.
  draftingDisabled Boolean      @default(false)
  /// Lowercased addresses this Bot may email without a review card.
  draftAllowedRecipients String[] @default([])
  /// Exchanges whose memory extraction has not finished; one left after a restart is reviewed with the next turn.
  pendingMemoryExchanges Json     @default("[]")
  avatarPath String?
  defaultDirectory String
  status BotStatus    @default(provisioning)
  onboardingStatus OnboardingStatus @default(pending)
  onboardingVersion Int         @default(1)
  onboardingCompletedAt DateTime?
  provisioningError Json?
  runtimeEngine String       @default("pi")
  inferenceProvider String?
  inferenceModel String?
  runtimeSessionId String?      @unique
  runtimeSessionPath String?     @unique
  conversation     Conversation?
  messages         Message[]
  runs             Run[]
  inboxEvents      InboxEvent[]
  lease            BotRunLease[]
  channelMemberships ChannelMember[]
  sentChannelMessages ChannelMessage[] @relation("ChannelMessageSenderBot")
  initiatedRounds  ChannelRound[]      @relation("ChannelRoundInitiator")
  channelDeliveries ChannelDelivery[]
  writtenMemoryFacts MemoryFact[]      @relation("MemoryFactWriter")
  savedSkills      SavedSkill[]
  routines         Routine[]
  fileStates       AgentFileState[]
  connectorStates  BotConnectorState[]
  todos            TodoItem[]
  parentSubagents  Subagent[]           @relation("ParentSubagents")
  subagentIdentity Subagent?            @relation("ChildSubagent")
  pluginActivities PluginActivity[]
  pluginInvocations PluginInvocation[]
  voiceSessions VoiceSession[]
  contextSessions ContextSession[]
  processSecrets ProcessSecret[]
  bitwardenReadApprovals BitwardenReadApproval[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, updatedAt], map: "outcomego_bot_status_updated_at_idx")
  @@map("outcomego_bot")
}

model TodoItem {
  botId String     @db.Uuid
  bot        Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  id String
  content String
  status TodoStatus
  position Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@id([botId, id], map: "outcomego_todo_item_bot_id_id_pkey")
  @@unique([botId, position], map: "outcomego_todo_item_bot_id_position_key")
  @@index([botId, status, position], map: "outcomego_todo_item_bot_id_status_position_idx")
  @@map("outcomego_todo_item")
}

model Subagent {
  id String         @id @default(uuid()) @db.Uuid
  parentBotId String         @db.Uuid
  parentBot        Bot            @relation("ParentSubagents", fields: [parentBotId], references: [id], onDelete: Cascade)
  childBotId String         @unique @db.Uuid
  childBot         Bot            @relation("ChildSubagent", fields: [childBotId], references: [id], onDelete: Cascade)
  parentRunId String         @db.Uuid
  requestRunId String?        @db.Uuid
  requestRun       Run?           @relation("RequestSubagents", fields: [requestRunId], references: [id], onDelete: SetNull)
  parentChannelId String         @db.Uuid
  currentRunId String?        @unique @db.Uuid
  launchCallId String
  description String
  prompt String
  subagentType String
  model String?
  reasoning String?
  taskConfiguration Json?
  fileAttachments Json           @default("[]")
  readOnly Boolean        @default(false)
  status SubagentStatus @default(provisioning)
  // Durable obligations survive a parked turn, process restart and context compaction.
  progress Json?
  progressRevision Int            @default(0)
  scopeUpdates Json           @default("[]")
  recoveryAttempts Int            @default(0)
  nextCheckAt DateTime?
  deadlineAt DateTime?
  result String?
  error Json?
  outputPath String
  startedAt DateTime?
  completedAt DateTime?
  stoppedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  attempts         SubagentAttempt[]

  @@unique([parentBotId, launchCallId], map: "outcomego_subagent_parent_bot_id_launch_call_id_key")
  @@index([parentBotId, status, createdAt], map: "outcomego_subagent_parent_bot_id_status_created_at_idx")
  @@index([childBotId, status], map: "outcomego_subagent_child_bot_id_status_idx")
  @@index([status, nextCheckAt], map: "outcomego_subagent_status_next_check_at_idx")
  @@index([requestRunId, status], map: "outcomego_subagent_request_run_id_status_idx")
  @@map("outcomego_subagent")
}

model SubagentAttempt {
  id String         @id @default(uuid()) @db.Uuid
  subagentId String         @db.Uuid
  subagent          Subagent       @relation(fields: [subagentId], references: [id], onDelete: Cascade)
  parentRunId String         @db.Uuid
  parentChannelId String         @db.Uuid
  parentToolCallId String
  childRunId String?        @unique @db.Uuid
  description String
  prompt String
  fileAttachments Json           @default("[]")
  status SubagentStatus @default(provisioning)
  result String?
  error Json?
  startedAt DateTime?
  completedAt DateTime?
  stoppedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([subagentId, parentToolCallId], map: "outcomego_subagent_attempt_subagent_id_parent_tool_call_id_key")
  @@index([parentChannelId, createdAt], map: "outcomego_subagent_attempt_parent_channel_id_created_at_idx")
  @@index([subagentId, status, createdAt], map: "outcomego_subagent_attempt_subagent_id_status_created_at_idx")
  @@map("outcomego_subagent_attempt")
}

model MemoryFact {
  id String      @id @default(uuid()) @db.Uuid
  namespace String
  scope MemoryScope
  tier MemoryTier  @default(log)
  fact String
  factHash String
  logicalId String      @default("")
  // Insertion order within the namespace; breaks createdAt ties.
  sourceOrdinal Int         @default(0)
  importance Float       @default(1)
  // How the fact was saved: tool, extract or template.
  origin String      @default("tool")
  // The run that saved the fact, when there was one.
  turnId String?
  writtenByBotId String?      @db.Uuid
  writtenByBot   Bot?         @relation("MemoryFactWriter", fields: [writtenByBotId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([namespace, logicalId, createdAt], map: "outcomego_memory_fact_namespace_logical_id_created_at_idx")
  @@index([namespace, tier, updatedAt], map: "outcomego_memory_fact_namespace_tier_updated_at_idx")
  @@index([writtenByBotId, updatedAt], map: "outcomego_memory_fact_written_by_bot_id_updated_at_idx")
  @@map("outcomego_memory_fact")
}

model SavedSkill {
  id String   @id @default(uuid()) @db.Uuid
  botId String?  @db.Uuid
  bot         Bot?     @relation(fields: [botId], references: [id], onDelete: SetNull)
  slug String   @unique
  name String
  description String
  body String
  frontmatter Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name], map: "outcomego_saved_skill_name_idx")
  @@index([updatedAt], map: "outcomego_saved_skill_updated_at_idx")
  @@map("outcomego_saved_skill")
}

model Routine {
  id String              @id @default(uuid()) @db.Uuid
  botId String?             @db.Uuid
  bot             Bot?                @relation(fields: [botId], references: [id], onDelete: Cascade)
  channelId String?             @db.Uuid
  executorBotId String?             @db.Uuid
  channel         Channel?            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  slug String
  name String
  prompt String
  trigger Json                @default("{}")
  triggerPresentation Json?
  provenance String              @default("untrusted")
  scheduleText String
  scheduleKind RoutineScheduleKind
  cronExpression String?
  intervalSeconds Int?
  timezoneMode String              @default("installation")
  timezone String
  enabled Boolean             @default(true)
  revision Int                 @default(1)
  nextRunAt DateTime?
  lastRunAt DateTime?
  pausedAt DateTime?
  deletedAt DateTime?
  pendingNotices Json                @default("[]")
  raisedNotices Json                @default("[]")
  runLedger Json                @default("[]")
  revisions       RoutineRevision[]
  executions      RoutineExecution[]
  webhook         AutomationWebhook?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([enabled, nextRunAt], map: "outcomego_routine_enabled_next_run_at_idx")
  @@index([botId, deletedAt, updatedAt], map: "outcomego_routine_bot_id_deleted_at_updated_at_idx")
  @@index([channelId, deletedAt, updatedAt], map: "outcomego_routine_channel_id_deleted_at_updated_at_idx")
  @@unique([botId, slug], map: "outcomego_routine_bot_id_slug_key")
  @@unique([channelId, slug], map: "outcomego_routine_channel_id_slug_key")
  @@map("outcomego_routine")
}

model RoutineRevision {
  id String              @id @default(uuid()) @db.Uuid
  routineId String              @db.Uuid
  routine         Routine             @relation(fields: [routineId], references: [id], onDelete: Cascade)
  revision Int
  name String
  prompt String
  scheduleText String
  scheduleKind RoutineScheduleKind
  cronExpression String?
  intervalSeconds Int?
  timezoneMode String
  timezone String
  enabled Boolean
  source String
  callId String?
  runId String?             @db.Uuid
  executions      RoutineExecution[]
  createdAt DateTime            @default(now())

  @@unique([routineId, revision], map: "outcomego_routine_revision_routine_id_revision_key")
  @@map("outcomego_routine_revision")
}

model RoutineExecution {
  id String                 @id @default(uuid()) @db.Uuid
  routineId String                 @db.Uuid
  routine           Routine                @relation(fields: [routineId], references: [id], onDelete: Cascade)
  routineRevisionId String                 @db.Uuid
  routineRevision   RoutineRevision        @relation(fields: [routineRevisionId], references: [id], onDelete: Restrict)
  runId String?                @unique @db.Uuid
  run               Run?                   @relation(fields: [runId], references: [id], onDelete: SetNull)
  channelMessageId String?                @unique @db.Uuid
  channelMessage    ChannelMessage?        @relation("RoutineTriggerMessage", fields: [channelMessageId], references: [id], onDelete: SetNull)
  kind RoutineExecutionKind
  status RoutineExecutionStatus @default(queued)
  dedupeKey String                 @unique
  scheduledFor DateTime
  enqueuedAt DateTime?
  startedAt DateTime?
  completedAt DateTime?
  skipReason String?
  error Json?
  // Listener events this execution's wake delivers, and the delivery keys it absorbed
  // while an earlier execution was queued or running.
  events Json?
  coalescedKeys String[]               @default([])
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([routineId, createdAt], map: "outcomego_routine_execution_routine_id_created_at_idx")
  @@index([status, createdAt], map: "outcomego_routine_execution_status_created_at_idx")
  @@map("outcomego_routine_execution")
}

model BotConnectorState {
  botId String   @db.Uuid
  bot          Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  platform String
  connected Boolean  @default(true)
  disconnectedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([botId, platform], map: "outcomego_bot_connector_state_bot_id_platform_pkey")
  @@index([platform, connected], map: "outcomego_bot_connector_state_platform_connected_idx")
  @@map("outcomego_bot_connector_state")
}

model Channel {
  id String           @id @default(uuid()) @db.Uuid
  kind ChannelKind
  name String
  description String           @default("")
  avatarPath String?
  directKey String?          @unique
  workingDirectory String?
  hiddenFromSidebar Boolean    @default(false)
  archivedAt DateTime?
  members     ChannelMember[]
  messages    ChannelMessage[]
  rounds      ChannelRound[]
  runs        Run[]
  bitwardenReadApprovals BitwardenReadApproval[]
  routines    Routine[]
  readState   ChannelReadState?
  notifications ChannelNotification[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  voiceSessions VoiceSession[]

  @@index([kind, updatedAt], map: "outcomego_channel_kind_updated_at_idx")
  @@map("outcomego_channel")
}

model ChannelReadState {
  channelId String   @id @db.Uuid
  channel          Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadSequence BigInt   @default(0)
  lastReadNotificationSequence BigInt @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("outcomego_channel_read_state")
}

model ChannelNotification {
  sequence BigInt @id @default(autoincrement())
  key String @unique
  channelId String @db.Uuid
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  botId String @db.Uuid
  kind String
  messageSequence BigInt?
  payload Json
  revoked Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([channelId, sequence], map: "outcomego_channel_notification_channel_id_sequence_idx")
  @@map("outcomego_channel_notification")
}

model ChannelMember {
  channelId String   @db.Uuid
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  botId String   @db.Uuid
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  ordinal Int
  createdAt DateTime @default(now())

  @@id([channelId, botId], map: "outcomego_channel_member_channel_id_bot_id_pkey")
  @@unique([channelId, ordinal], map: "outcomego_channel_member_channel_id_ordinal_key")
  @@index([botId, channelId], map: "outcomego_channel_member_bot_id_channel_id_idx")
  @@map("outcomego_channel_member")
}

model ChannelMessage {
  id String               @id @default(uuid()) @db.Uuid
  sequence BigInt               @default(autoincrement())
  channelId String               @db.Uuid
  channel        Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender ChannelMessageSender
  senderBotId String?              @db.Uuid
  senderBot      Bot?                 @relation("ChannelMessageSenderBot", fields: [senderBotId], references: [id], onDelete: SetNull)
  sourceRunId String?              @db.Uuid
  sourceRun      Run?                 @relation("VisibleRunMessage", fields: [sourceRunId], references: [id], onDelete: SetNull)
  clientId String?
  content String               @default("")
  metadata Json                 @default("{}")
  triggeredRound ChannelRound?        @relation("RoundTrigger")
  routineExecution RoutineExecution?  @relation("RoutineTriggerMessage")
  createdAt DateTime             @default(now())

  @@unique([channelId, clientId], map: "outcomego_channel_message_channel_id_client_id_key")
  @@index([channelId, sequence], map: "outcomego_channel_message_channel_id_sequence_idx")
  @@index([senderBotId, createdAt], map: "outcomego_channel_message_sender_bot_id_created_at_idx")
  @@map("outcomego_channel_message")
}

model ChannelRound {
  id String             @id @default(uuid()) @db.Uuid
  channelId String             @db.Uuid
  channel        Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  triggerMessageId String           @unique @db.Uuid
  triggerMessage ChannelMessage     @relation("RoundTrigger", fields: [triggerMessageId], references: [id], onDelete: Cascade)
  rootMessageId String             @db.Uuid
  roundIndex Int                @default(0)
  memberTurnOffset Int              @default(0)
  initiatorBotId String?            @db.Uuid
  initiatorBot   Bot?               @relation("ChannelRoundInitiator", fields: [initiatorBotId], references: [id], onDelete: SetNull)
  status ChannelRoundStatus @default(queued)
  currentOrdinal Int                @default(-1)
  deliveries     ChannelDelivery[]
  completedAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([channelId, status, createdAt], map: "outcomego_channel_round_channel_id_status_created_at_idx")
  @@index([rootMessageId, roundIndex], map: "outcomego_channel_round_root_message_id_round_index_idx")
  @@map("outcomego_channel_round")
}

model ChannelDelivery {
  id String                @id @default(uuid()) @db.Uuid
  roundId String                @db.Uuid
  round       ChannelRound          @relation(fields: [roundId], references: [id], onDelete: Cascade)
  botId String                @db.Uuid
  bot         Bot                   @relation(fields: [botId], references: [id], onDelete: Cascade)
  ordinal Int
  status ChannelDeliveryStatus @default(pending)
  run         Run?
  startedAt DateTime?
  completedAt DateTime?
  error Json?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([roundId, botId], map: "outcomego_channel_delivery_round_id_bot_id_key")
  @@unique([roundId, ordinal], map: "outcomego_channel_delivery_round_id_ordinal_key")
  @@index([botId, status, createdAt], map: "outcomego_channel_delivery_bot_id_status_created_at_idx")
  @@map("outcomego_channel_delivery")
}

model Conversation {
  id String                 @id @default(uuid()) @db.Uuid
  botId String                 @unique @db.Uuid
  bot            Bot                    @relation(fields: [botId], references: [id], onDelete: Cascade)
  continuity ConversationContinuity @default(empty)
  compactionEpoch Int                   @default(0)
  messages       Message[]
  runs           Run[]
  voiceSessions  VoiceSession[]
  inboxEvents    InboxEvent[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  @@map("outcomego_conversation")
}

model ContextSession {
  id String              @id @default(uuid()) @db.Uuid
  botId String              @db.Uuid
  bot                Bot                 @relation(fields: [botId], references: [id], onDelete: Cascade)
  scope String
  scopeId String              @db.Uuid
  runtimeSessionId String?             @unique
  runtimeSessionPath String?             @unique
  inferenceProvider String?
  inferenceModel String?
  compactionEpoch Int                 @default(0)
  lastArchiveId String?             @db.Uuid
  compactions        ContextCompaction[]
  promptSnapshot     ContextPromptSnapshot?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([botId, scope, scopeId], map: "outcomego_context_session_bot_id_scope_scope_id_key")
  @@index([botId, scope], map: "outcomego_context_session_bot_id_scope_idx")
  @@map("outcomego_context_session")
}

model ContextCompaction {
  id String         @id @db.Uuid
  contextSessionId String         @db.Uuid
  contextSession   ContextSession @relation(fields: [contextSessionId], references: [id], onDelete: Cascade)
  sequence Int
  reason String
  prefixDigest String
  summaryDigest String
  status String         @default("adopted")
  tokensBefore Int?
  tokensAfter Int?
  imageCount Int            @default(0)
  turnCount Int            @default(0)
  startedAt DateTime
  completedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([contextSessionId, sequence], map: "outcomego_context_compaction_context_session_id_sequence_key")
  @@index([contextSessionId, status], map: "outcomego_context_compaction_context_session_id_status_idx")
  @@map("outcomego_context_compaction")
}

model ContextPromptSnapshot {
  contextSessionId String         @id @db.Uuid
  contextSession        ContextSession @relation(fields: [contextSessionId], references: [id], onDelete: Cascade)
  profileEpoch Int            @default(-1)
  profileSection String         @default("")
  systemName String         @default("")
  systemDescription String         @default("")
  announcedName String         @default("")
  announcedDescription String         @default("")
  skillEpoch Int            @default(-1)
  skillRender String         @default("")
  promptSections Json           @default("{}")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  @@map("outcomego_context_prompt_snapshot")
}

model AgentFileState {
  path String   @id
  botId String?  @db.Uuid
  bot           Bot?     @relation(fields: [botId], references: [id], onDelete: Cascade)
  kind String
  digest String?
  validDigest String?
  exists Boolean  @default(true)
  error String?
  generation Int      @default(0)
