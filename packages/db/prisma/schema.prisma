  status RunStatus    @default(queued)
  runtimeTurnId String?
  inferenceProvider String?
  inferenceModel String?
  inferenceReasoning String?
  taskConfiguration Json?
  origin RunOrigin    @default(user)
  // A parent request can outlive this model turn and several scoped workers.
  requestProgress Json?
  requestRevision Int @default(0)
