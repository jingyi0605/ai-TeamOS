  @@map("outcomego_apns_settings")
}

// Ephemeral availability, distinct from push registration and read state.
model NotificationPresence {
  clientId String @id @db.Uuid
  sequence Int
  platform String
  authRequired Boolean
  authSessionId String?
  authSession Session? @relation(fields: [authSessionId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  updatedAt DateTime @updatedAt
  @@index([expiresAt], map: "outcomego_notification_presence_expires_at_idx")
  @@index([authSessionId], map: "outcomego_notification_presence_auth_session_id_idx")
  @@map("outcomego_notification_presence")
}

/// The user's time zone. The apps report the zone their device detects; an override chosen in
/// Settings wins. Routines, the box clock and the prompt's Time section all use override ?? detected.
model UserTimeZoneSettings {
  id String   @id @default("global")
  detected String?
  override String?
  updatedAt DateTime @updatedAt
  @@map("outcomego_user_time_zone_settings")
}

model NotificationPreferences {
  id String @id @default("global")
  smartEnabled Boolean @default(true)
  @@map("outcomego_notification_preferences")
}
