{
  "name": "outcomego",
  "version": "0.1.0-beta.15",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/client-core",
    "packages/contracts",
    "packages/db",
    "packages/design-tokens",
    "packages/messaging",
    "packages/product-core",
    "packages/plugin-sdk",
    "packages/plugins",
    "packages/shell-jobs"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "bun run prepare:plugins && turbo run typecheck",
    "test": "bun run prepare:plugins && turbo run test",
    "check": "bun run typecheck && bun run test && bun run build && bun scripts/performance/check-desktop-budgets.ts",
    "check:architecture": "bun scripts/check/workspace-boundaries.ts && bun scripts/check/contract-enum-parity.ts && bun scripts/check/ios-bundle-boundary.ts && bun scripts/check/client-source-duplication.ts && bun scripts/check/i18n-catalog.ts && bun scripts/check/i18n-cli-catalog.ts",
    "check:workflows": "bun scripts/check/release-workflows.ts",
    "check:i18n": "bun scripts/check/i18n-catalog.ts && bun scripts/check/i18n-cli-catalog.ts",
    "test:health:chaos": "bun scripts/test-health-chaos.ts",
    "test:cli:e2e": "bun scripts/test-cli-e2e.ts",
    "test:auth:e2e": "bun scripts/test-auth-e2e.ts",
    "test:browser-network:linux": "bun scripts/test-browser-network-linux.ts",
    "test:computer-network:linux": "bun scripts/test-computer-network-linux.ts",
    "test:browser-network:chaos": "bun test apps/server/test/browser-network.test.ts --test-name-pattern chaos && bun test packages/plugin-sdk/test/browser-network/client.test.ts packages/plugin-sdk/test/browser-network/mux.test.ts apps/desktop/test/network apps/computer/test/display-settings.test.ts apps/computer/test/browser-network-worker.test.ts apps/computer/test/browser-network-quality.test.ts apps/computer/test/browser-network-egress.test.ts",
    "db:generate": "bun --filter @outcomego/db db:generate",
    "db:push": "bun --filter @outcomego/db db:push",
    "db:deploy": "bun --filter @outcomego/db db:deploy",
    "db:studio": "bun --filter @outcomego/db db:studio",
    "auth:setup": "bun scripts/setup-dev-auth.ts",
    "compose:up": "bash scripts/compose.sh up --build",
    "compose:down": "bash scripts/compose.sh down",
    "desktop": "bun --filter @outcomego/desktop dev",
    "desktop:performance": "bun --filter @outcomego/desktop build && bun scripts/performance/check-desktop-budgets.ts",
    "desktop:performance:release": "bun --filter @outcomego/desktop package",
    "desktop:tailscale": "bash scripts/tailscale-dev.sh",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "ios:performance": "bun --filter @outcomego/ios performance",
    "prepare:plugins": "bun packages/plugins/scripts/generate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/bun": "1.3.8",
    "turbo": "2.10.11",
    "typescript": "5.9.3"
  },
  "patchedDependencies": {
    "@earendil-works/pi-coding-agent@0.84.3": "patches/@earendil-works%2Fpi-coding-agent@0.84.3.patch",
    "playwright-core@1.55.0": "patches/playwright-core@1.55.0.patch",
    "@earendil-works/pi-ai@0.84.3": "patches/@earendil-works%2Fpi-ai@0.84.3.patch",
    "streamdown@2.6.0": "patches/streamdown@2.6.0.patch"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "deepmerge-ts": "8.0.1",
    "esbuild": "0.28.1",
    "mysql2": "3.24.2",
    "pg": "8.23.0",
    "postcss": "8.5.26",
    "uuid": "14.0.2",
    "ws": "8.21.3"
  }
}
